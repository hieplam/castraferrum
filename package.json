{
  "name": "castraferrum",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Castraferrum: a local web UI that runs and watches agent loops",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "postinstall": "playwright install chromium && node scripts/install-webkit.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "node scripts/dev.mjs",
    "start": "node --import tsx server/main.ts",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "arch": "node scripts/arch-check.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:contract": "node scripts/test-contract.mjs",
    "test:api": "vitest run --project api",
    "api-smoke": "node scripts/api-smoke.mjs",
    "test:e2e": "playwright test",
    "uc-coverage": "node scripts/uc-coverage.mjs",
    "bench:transcript": "node --import tsx scripts/bench-transcript.mjs",
    "design:shots": "node scripts/design-shots.mjs",
    "design:states": "node scripts/design-states.mjs",
    "design:compare": "node scripts/design-compare.mjs",
    "design:tokens": "node scripts/design-tokens.mjs",
    "design:lint": "node scripts/design-lint.mjs",
    "ratchets": "node scripts/ratchets.mjs",
    "phone:check": "node --import tsx scripts/phone-check.mts",
    "db:generate": "drizzle-kit generate",
    "verify": "npm run typecheck && node scripts/lang-scan.mjs --check-baseline && npm run arch && npm run ratchets -- --base main && npm run test:unit && npm run test:contract && npm run test:api && npm run api-smoke && npm run build && npm run test:e2e && npm run uc-coverage -- --min 32"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.303",
    "@fastify/static": "10.1.6",
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@tanstack/react-query": "5.104.4",
    "croner": "10.0.1",
    "cronstrue": "3.32.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "18.6.0",
    "drizzle-kit": "0.31.11",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
