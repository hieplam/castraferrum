# Copy to .env (same folder) when you need to change a default. docker compose, npm start, vitest and playwright all read this file.
# Anything left unset uses exactly the values below.

# API + UI port (built bundle)
LOOPS_PORT=7070
# Postgres port on the host (compose.yml maps it to 5432 in the container)
LOOPS_PG_PORT=55432
# Port of the e2e-only server (Playwright starts it, DB loops_test)
LOOPS_E2E_PORT=7071

# Derived from LOOPS_PG_PORT by default; set only when Postgres lives elsewhere
# DATABASE_URL=postgres://loops:loops@127.0.0.1:55432/loops
# LOOPS_TEST_DATABASE_URL=postgres://loops:loops@127.0.0.1:55432/loops_test

# Docker names used by compose.yml (defaults shown). Override them to run a second, separate Postgres
# next to an existing one; the default volume name holds real loop history, so never reuse it by accident.
# LOOPS_COMPOSE_PROJECT=loop-console
# LOOPS_PG_CONTAINER=loop_console_pg
# LOOPS_PG_VOLUME=loop_console_pg
